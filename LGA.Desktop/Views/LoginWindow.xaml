<Window x:Class="LGA.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LGA.Desktop.Views"
        mc:Ignorable="d"
        Title="IntuitiveBMI Lead Generation App (Beta)" Height="800" Width="1190" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="0,0,0,0">

        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/Images/Background.png"
                    Stretch="Fill"/>
        </Grid.Background>

        <!-- Login Card -->
        <Border Width="551"
            HorizontalAlignment="Left"
            Margin="591,40,0,40"
            Background="White"
            CornerRadius="20"
            Padding="35">

            <StackPanel>

                <!-- Top Icon -->
                <Border Width="90"
                    Height="90"
                    Background="#EEF5FF"
                    CornerRadius="45"
                    HorizontalAlignment="Center">

                    <TextBlock Text="🔒"
                           FontSize="40"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,15,0,0"/>
                </Border>

                <TextBlock Text="Welcome!"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,5"/>

                <TextBlock Text="Please sign in with your account."
                       FontSize="15"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,35"/>

                <!-- Email -->
                <TextBlock Text="Email"
                       FontWeight="SemiBold"
                       FontSize="16"/>

                <Border Height="48"
                    Margin="0,8,0,20"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="✉"
                               FontSize="18"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="Gray"/>

                        <TextBox Grid.Column="1"
                             BorderThickness="0"
                             Text="{Binding Email,UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="15"
                             KeyDown="Login_KeyDown"/>

                    </Grid>

                </Border>

                <!-- Password -->
                <TextBlock Text="Password"
                       FontWeight="SemiBold"
                       FontSize="16"/>

                <Border Height="48"
                    Margin="0,8,0,15"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="8">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🔒"
                               FontSize="17"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="Gray"/>

                        <Grid Grid.Column="1">

                            <PasswordBox x:Name="PasswordBox"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     FontSize="15"
                                     KeyDown="Login_KeyDown"/>

                            <TextBox x:Name="PasswordTextBox"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 FontSize="15"
                                 Visibility="Collapsed"
                                 KeyDown="Login_KeyDown"/>

                        </Grid>

                        <Button Grid.Column="2"
                            Width="36"
                            Height="36"
                            Cursor="Hand"
                            Click="BtnShowPassword_Click">

                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </Button.Style>

                            <TextBlock Text="👁"
                                   FontSize="16"
                                   Foreground="#808080"/>

                        </Button>

                    </Grid>

                </Border>

                <!-- Remember -->
                <Grid Margin="0,0,0,30">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="Remember me"
                          VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">

                    <Hyperlink Click="ForgotPassword_Click">
                        <Run Text="Forgot password?"/>
                    </Hyperlink>

                    </TextBlock>

                </Grid>

                <!-- Login Button -->
                <Button Height="50"
                    Background="#2563EB"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Content="Sign In"
                    Command="{Binding LoginCommand}" />

                <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#DC2626"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Visibility="Visible"/>

                <Separator Margin="0,30,0,20"/>

                <TextBlock HorizontalAlignment="Center">

                <Run Text="Need an account? "/>

                <Hyperlink Click="ContactAdministrator_Click">
                    <Run Text="Contact Administrator."
                            FontWeight="SemiBold"/>
                </Hyperlink>

                </TextBlock>

            </StackPanel>

        </Border>

        <!-- Copyright -->
        <Border
    HorizontalAlignment="Left"
    VerticalAlignment="Bottom"
    Margin="15"
    Padding="8,4"
    Background="#66000000"
    CornerRadius="3">

            <TextBlock
        FontSize="12"
        Foreground="White"
        Text="© 2026 Intuitive BMI, Inc. All rights reserved."/>

        </Border>

    </Grid>
</Window>
