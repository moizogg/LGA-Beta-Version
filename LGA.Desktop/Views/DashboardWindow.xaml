<Window x:Class="LGA.Desktop.Views.DashboardWindow"

xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

Title="LGA Dashboard"

Width="1400"

Height="850"

WindowStartupLocation="CenterScreen">


    <Grid>


        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="260"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- LEFT MENU -->

        <Border

Grid.Column="0"

Background="#111827">


            <StackPanel>


                <TextBlock

Text="LGA"

Foreground="White"

FontSize="32"

FontWeight="Bold"

Margin="30"/>



                <TextBlock

Text="AI Agent Platform"

Foreground="#9CA3AF"

Margin="30,0,0,40"/>



                <Button

Content="Dashboard"

Height="45"

Margin="20,5"/>



                <Button

Content="Lead Management"

Height="45"

Margin="20,5"/>



                <Button

Content="AI Agents"

Height="45"

Margin="20,5"/>



                <Button

Content="Workflow"

Height="45"

Margin="20,5"/>



                <Button

Content="Settings"

Height="45"

Margin="20,5"/>



            </StackPanel>


        </Border>



        <!-- MAIN CONTENT -->

        <Grid Grid.Column="1"
      Background="#F3F4F6">


            <StackPanel Margin="40">


                <TextBlock

Text="{Binding WelcomeMessage}"

FontSize="32"

FontWeight="Bold"/>



                <TextBlock

Text="{Binding UserName}"

FontSize="20"

Margin="0,10,0,30"/>



                <Grid>


                    <Grid.ColumnDefinitions>

                        <ColumnDefinition/>

                        <ColumnDefinition/>

                        <ColumnDefinition/>

                    </Grid.ColumnDefinitions>



                    <!-- Card 1 -->

                    <Border

Grid.Column="0"

Background="White"

CornerRadius="15"

Margin="10"

Padding="25">


                        <StackPanel>


                            <TextBlock

Text="Leads"

FontSize="20"

FontWeight="Bold"/>


                            <TextBlock

Text="0"

FontSize="40"

Margin="0,20"/>


                        </StackPanel>


                    </Border>



                    <!-- Card 2 -->


                    <Border

Grid.Column="1"

Background="White"

CornerRadius="15"

Margin="10"

Padding="25">


                        <StackPanel>


                            <TextBlock

Text="AI Agents"

FontSize="20"

FontWeight="Bold"/>
                            <Button

Content="Run AI Agent"

Command="{Binding RunAgentCommand}"

Height="50"

Width="200"

Margin="0,30,0,0"

Background="#2563EB"

Foreground="White"/>

                            <TextBlock

Text="Active"

FontSize="40"

Margin="0,20"/>


                        </StackPanel>


                    </Border>



                    <!-- Card 3 -->


                    <Border

Grid.Column="2"

Background="White"

CornerRadius="15"

Margin="10"

Padding="25">


                        <StackPanel>


                            <TextBlock

Text="Workflow"

FontSize="20"

FontWeight="Bold"/>


                            <TextBlock

Text="Ready"

FontSize="40"

Margin="0,20"/>


                        </StackPanel>


                    </Border>


                </Grid>


            </StackPanel>


        </Grid>


    </Grid>


</Window>